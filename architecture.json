  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-Masking Architecture",
      "items": [
        "No fragile __VAR_N__ masking or placeholder leak risks",
        "Registers ${...}, {{...}}, {...}, %s, %(name)s as paramTypes.custom",
        "Supports all standard dialects: PostgreSQL, BigQuery, MySQL, SQLite, Snowflake"
      ]
    },
    {
      "dot": "emerald",
      "title": "Intelligent Post-Processing",
      "items": [
        "AST tokenizer tracks SELECT scope, aliases, and expressions",
        "Resolves GROUP BY 1, 2 and ORDER BY 1 to column names or aliases",
        "Safely preserves aggregations (COUNT(*)) and template placeholders"
      ]
    },
    {
      "dot": "rose",
      "title": "VS Code Native Integration",
      "items": [
        "Registers DocumentFormattingEditProvider & DocumentRangeFormattingEditProvider",
        "Works seamlessly with Shift+Alt+F, selection format, and formatOnSave",
        "Fail-safe: shows warning on syntax error without corrupting file"
      ]
    }
  ]
